# Copy to .env on the server and fill real values there.
SECRET_KEY=change-me
BOT_TOKEN=123456:replace-with-telegram-bot-token
BOT_USERNAME=your_bot_username
TELEGRAM_MINI_APP_SHORT_NAME=
HR_TELEGRAM_BOT_TOKEN=123456:replace-with-hr-bot-token
ADMIN_IDS=7719402429

SUPERADMIN_LOGIN=UnicoM
SUPERADMIN_PASSWORD=change-me
SYNC_SUPERADMIN_PASSWORD=true

DB_USER=postgres
DB_PASS=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=shop_db

WEB_BASE_URL=https://unicombot.uz
HR_WORKSPACE_URL=/hr/
HR_INTERNAL_URL=http://hr:3000
DOMAIN=unicombot.uz
WWW_DOMAIN=www.unicombot.uz
LETSENCRYPT_EMAIL=admin@unicombot.uz
ENABLE_LETSENCRYPT=true
DEPLOY_HEALTHCHECK_URL=https://unicombot.uz/health
SESSION_HTTPS_ONLY=true

PAYME_ID=replace-me
PAYME_KEY=replace-me
PAYME_URL=https://checkout.paycom.uz
PAYME_ACCOUNT_FIELD=order_id
PAYME_MIN_AMOUNT=100000

CLICK_SERVICE_ID=replace-me
CLICK_MERCHANT_ID=replace-me
CLICK_SECRET_KEY=replace-me
CLICK_MERCHANT_USER_ID=replace-me

ORDER_PAYMENT_TIMEOUT_MINUTES=20
MIN_ORDER_AMOUNT=100
DEFAULT_PACKAGE_CODE=000000

REDIS_URL=redis://redis:6379/0
CACHE_TTL=300
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT=5/minute
NOTIFY_ADMINS_ON_NEW_ORDER=true
